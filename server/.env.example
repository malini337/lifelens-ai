# ---- Required ----
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Replace <password> and add a database name.
MONGO_URI=
# Any long random string, e.g. generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# AI key (kept on the server only - NEVER put it in the client folder)
AI_API_KEY=

# ---- Optional (defaults shown) ----
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_EXPIRES_IN=7d
# anthropic (default) or gemini
AI_PROVIDER=anthropic
# Leave empty to use the provider's default model
AI_MODEL=
